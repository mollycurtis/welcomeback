# Copy to .env.local and fill in. These are the only runtime settings (all three are
# NEXT_PUBLIC, so they ship in the client by design: nothing secret belongs here).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_COUNTER_URL=https://api.counterapi.dev/v2/<workspace>/<counter>
NEXT_PUBLIC_COUNTER_OFFSET=0
